# No production credentials belong in Git. Set these using a root-owned environment file.
PULSE_ADMIN_USERNAME=admin
PULSE_ADMIN_PASSWORD=
PULSE_ALLOWED_HOSTS=www.aliyun.com,example.com
PULSE_SEED_TARGETS=
PULSE_SECURE_COOKIE=true
PULSE_ICP_NUMBER=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080
PULSE_TRUSTED_PROXIES=127.0.0.1,::1
DB_URL=jdbc:mysql://your-rds-internal-host:3306/pulseops?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USERNAME=pulseops
DB_PASSWORD=
DB_POOL_SIZE=4
PULSE_MONITOR_LIMIT=30
PULSE_RETENTION_DAYS=30
