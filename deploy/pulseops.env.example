# Root-owned /etc/pulseops/pulseops.env; chmod 600; LF; never commit real values.
# Use KEY=value without shell quoting, whitespace or backslashes for required keys.
PULSE_ADMIN_USERNAME=admin
PULSE_ADMIN_PASSWORD=
DB_URL=jdbc:mysql://RDS_INTERNAL_HOST:3306/pulseops?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USERNAME=pulseops
DB_PASSWORD=
DB_POOL_SIZE=4
# For host systemd: replace with the verified Docker bridge gateway before Caddy access.
# 127.0.0.1 is safe for local health checks but is unreachable from bridge-mode Caddy.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080
PULSE_SECURE_COOKIE=true
# Replace with the verified exact Caddy peer IP; Caddy must overwrite X-Real-IP.
PULSE_TRUSTED_PROXIES=127.0.0.1
PULSE_ALLOWED_HOSTS=pulse.ldjava.com
PULSE_SEED_TARGETS=
PULSE_ICP_NUMBER=
PULSE_RETENTION_DAYS=30
PULSE_MONITOR_LIMIT=30
